{
  // https://github.com/DavidAnson/markdownlint-cli2
  "config": {
    "default": true,
    "MD013": false,          // line length: prose and tables are long
    "MD033": false,          // inline HTML (used for diagrams/details)
    "MD041": false,          // first line heading (templates start with frontmatter)
    "MD024": { "siblings_only": true },
    "MD026": false,          // trailing punctuation in headings (Korean headings)
    "MD034": false,          // bare URLs are fine in reference lists
    "MD036": false,          // bold line as pseudo-heading
    "MD040": false,          // fenced blocks without language (output templates)
    "MD029": false,          // ordered list numbering style
    "MD028": false,          // blank line inside blockquote
    "MD060": false,          // table pipe alignment is cosmetic
    "MD025": { "front_matter_title": "" } // design docs: front-matter title is data for board.py, H1 is for readers
  },
  "ignores": ["node_modules/**", ".venv/**", "CHANGELOG.md"]
}
