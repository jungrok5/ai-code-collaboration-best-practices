# Public URL people and agents use (links in notifications and the web UI). Use HTTPS in production.
AGENT_RELAY_PUBLIC_URL=https://agent-relay.example.internal
# SSO mode: set only when a trusted reverse proxy (e.g. oauth2-proxy) is the only way to reach the relay
# and sets this header to the signed-in user's email. Leave empty to use admin-issued tokens only.
AGENT_RELAY_TRUSTED_HEADER=
# Optional webhook for wake-up events (Teams Workflows HTTP trigger, Slack workflow, ...).
AGENT_RELAY_NOTIFY_URL=
# Largest message body in bytes.
AGENT_RELAY_MAX_MESSAGE_BYTES=16384
