{
  "name": "main: automatic Copilot code review (requires Copilot Business/Enterprise or Pro)",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] }
  },
  "rules": [
    {
      "type": "copilot_code_review",
      "parameters": { "review_on_push": true, "review_draft_pull_requests": false }
    }
  ]
}
